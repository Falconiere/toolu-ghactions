{
  "name": "toolu-code-review",
  "version": "2.4.0",
  "private": true,
  "description": "Toolu AI Code Review — GitHub JS action (TypeScript, OpenRouter + Vercel AI SDK)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware --deny-warnings --ignore-pattern=evals",
    "lint:fix": "oxlint --fix --ignore-pattern=evals",
    "fmt": "oxfmt '!evals/**' '!run/index.cjs' '!sanitize-sarif/index.cjs'",
    "fmt:check": "oxfmt --check '!evals/**' '!run/index.cjs' '!sanitize-sarif/index.cjs'",
    "prepare": "cd \"$(git rev-parse --show-toplevel)\" && lefthook install",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "eval": "bun evals/run.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@ai-sdk/deepseek": "0.2.16",
    "@ai-sdk/openai-compatible": "0.2.16",
    "@octokit/auth-app": "^8.3.1",
    "@openrouter/ai-sdk-provider": "^0.7.0",
    "ai": "^4.3.0",
    "jsonrepair": "^3.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
